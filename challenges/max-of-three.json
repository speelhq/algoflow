{
  "id": "max-of-three",
  "title": { "en": "Max of three" },
  "difficulty": "easy",
  "topics": ["conditions"],
  "description": {
    "en": "Store the largest of `a`, `b`, and `c` in `largest` using **if** blocks, not the `max` builtin."
  },
  "inputs": [
    { "name": "a", "kind": "number" },
    { "name": "b", "kind": "number" },
    { "name": "c", "kind": "number" }
  ],
  "tests": [
    {
      "inputs": { "a": 3, "b": 9, "c": 5 },
      "expect": { "variables": { "largest": 9 } }
    },
    {
      "inputs": { "a": 3, "b": 3, "c": 3 },
      "edge": true,
      "expect": { "variables": { "largest": 3 } }
    },
    {
      "inputs": { "a": -5, "b": -2, "c": -9 },
      "expect": { "variables": { "largest": -2 } }
    },
    {
      "inputs": { "a": 1, "b": 2, "c": 7 },
      "expect": { "variables": { "largest": 7 } }
    }
  ],
  "hints": [
    { "en": "Use two **if** blocks, one for `b` and one for `c`." },
    {
      "en": "Each **if** asks whether its value is greater than `largest`, the largest so far: `b > largest?`."
    },
    {
      "en": "Before them add `largest ← a`, and on the **Yes** side of each `largest ← b` or `largest ← c`."
    }
  ],
  "takeaway": { "en": "Two **if** blocks replaced `largest` whenever a larger value appeared." },
  "solution": {
    "version": 1,
    "title": "Max of three",
    "challengeId": "max-of-three",
    "inputs": [
      { "name": "a", "kind": "number" },
      { "name": "b", "kind": "number" },
      { "name": "c", "kind": "number" }
    ],
    "classes": [],
    "functions": [],
    "main": [
      {
        "id": "max-init-001",
        "type": "assign",
        "target": { "id": "max-tgt-0001", "type": "var", "name": "largest" },
        "value": { "id": "max-avar-001", "type": "var", "name": "a" }
      },
      {
        "id": "max-ifb0-001",
        "type": "if",
        "cond": {
          "id": "max-gtb0-001",
          "type": "binop",
          "op": ">",
          "left": { "id": "max-bvar-001", "type": "var", "name": "b" },
          "right": { "id": "max-lrg0-001", "type": "var", "name": "largest" }
        },
        "then": [
          {
            "id": "max-setb-001",
            "type": "assign",
            "target": { "id": "max-tgt-0002", "type": "var", "name": "largest" },
            "value": { "id": "max-bvar-002", "type": "var", "name": "b" }
          }
        ],
        "else": []
      },
      {
        "id": "max-ifc0-001",
        "type": "if",
        "cond": {
          "id": "max-gtc0-001",
          "type": "binop",
          "op": ">",
          "left": { "id": "max-cvar-001", "type": "var", "name": "c" },
          "right": { "id": "max-lrg0-002", "type": "var", "name": "largest" }
        },
        "then": [
          {
            "id": "max-setc-001",
            "type": "assign",
            "target": { "id": "max-tgt-0003", "type": "var", "name": "largest" },
            "value": { "id": "max-cvar-002", "type": "var", "name": "c" }
          }
        ],
        "else": []
      }
    ]
  }
}
