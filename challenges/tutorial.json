{
  "id": "tutorial",
  "title": { "en": "Hello" },
  "difficulty": "easy",
  "topics": ["output"],
  "description": {
    "en": "Say hello to `name`.\n\nAdd a **print** block with the `+` under `Start` and give it the text `\"Hello, \"` joined to `name` with `+`."
  },
  "inputs": [{ "name": "name", "value": "Claude" }],
  "tests": [
    {
      "inputs": { "name": "Claude" },
      "expect": { "stdout": ["Hello, Claude"] }
    },
    {
      "inputs": { "name": "" },
      "edge": true,
      "expect": { "stdout": ["Hello, "] }
    },
    { "inputs": { "name": "Ada" }, "expect": { "stdout": ["Hello, Ada"] } }
  ],
  "hints": [
    { "en": "Click the `+` under `Start` and choose **Print** under Basic." },
    { "en": "Click the print slot and choose a text value, then use `+` to join `name` to it." },
    { "en": "The text is `\"Hello, \"` with a space after the comma." }
  ],
  "takeaway": { "en": "You printed text joined to an input with `+`." },
  "solution": {
    "version": 1,
    "title": "Hello",
    "challengeId": "tutorial",
    "inputs": [{ "name": "name", "value": "Claude" }],
    "classes": [],
    "functions": [],
    "main": [
      {
        "id": "tut-prnt-001",
        "kind": "print",
        "args": [
          {
            "id": "tut-plus-001",
            "kind": "binop",
            "op": "+",
            "left": { "id": "tut-text-001", "kind": "str", "value": "Hello, " },
            "right": { "id": "tut-name-001", "kind": "var", "name": "name" }
          }
        ]
      }
    ]
  }
}
