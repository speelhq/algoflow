{
  "id": "countdown",
  "title": { "en": "Countdown" },
  "difficulty": "easy",
  "topics": ["loops"],
  "description": {
    "en": "Print `n`, then `n - 1`, and so on down to `0`, one number per line. Use a **while** block."
  },
  "inputs": [{ "name": "n", "kind": "number" }],
  "tests": [
    {
      "inputs": { "n": 5 },
      "expect": { "stdout": ["5", "4", "3", "2", "1", "0"] }
    },
    { "inputs": { "n": 0 }, "edge": true, "expect": { "stdout": ["0"] } },
    { "inputs": { "n": 2 }, "expect": { "stdout": ["2", "1", "0"] } }
  ],
  "hints": [
    { "en": "Use a **while** block, which repeats its body as long as its condition holds." },
    {
      "en": "Count down with `n` itself: a **while** block whose check is `n >= 0?`."
    },
    { "en": "Inside the loop, `print(n)`, then `n ← n - 1`, or the loop never ends." }
  ],
  "takeaway": { "en": "A **while** loop kept going until its condition became false." },
  "solution": {
    "version": 1,
    "title": "Countdown",
    "challengeId": "countdown",
    "inputs": [{ "name": "n", "kind": "number" }],
    "classes": [],
    "functions": [],
    "main": [
      {
        "id": "cnt-loop-001",
        "type": "while",
        "cond": {
          "id": "cnt-ge00-001",
          "type": "binop",
          "op": ">=",
          "left": { "id": "cnt-nvar-001", "type": "var", "name": "n" },
          "right": { "id": "cnt-zero-001", "type": "num", "value": 0, "float": false, "raw": "0" }
        },
        "body": [
          {
            "id": "cnt-prnt-001",
            "type": "print",
            "args": [{ "id": "cnt-nvar-002", "type": "var", "name": "n" }]
          },
          {
            "id": "cnt-decr-001",
            "type": "assign",
            "target": { "id": "cnt-tgt-0002", "type": "var", "name": "n" },
            "value": {
              "id": "cnt-mins-001",
              "type": "binop",
              "op": "-",
              "left": { "id": "cnt-nvar-003", "type": "var", "name": "n" },
              "right": {
                "id": "cnt-one0-001",
                "type": "num",
                "value": 1,
                "float": false,
                "raw": "1"
              }
            }
          }
        ]
      }
    ]
  }
}
